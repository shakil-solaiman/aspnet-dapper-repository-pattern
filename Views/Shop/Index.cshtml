@model IEnumerable<WebApplication3.Models.Product>

<h2>All Products List</h2>

<p>
    <a asp-action="ProductsByPrice" class="btn btn-primary">Search Products by Price</a>
    <a asp-action="SalesDetails" class="btn btn-primary">Sales Report</a>
   
    <hr/>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Product ID</th>
            <th>Product Name</th>
            <th>Price</th>
            <th>Stock Quantity</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductId</td>
                <td>@product.ProductName</td>
                <td>@product.Price</td>
                <td>@product.StockQuantity</td>
            </tr>
        }
    </tbody>
</table>