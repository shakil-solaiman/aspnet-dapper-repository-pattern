@model IEnumerable<WebApplication3.DTOs.SalesDetailsDto>

<h2>Sales Report by Customer and Product</h2>

<p>
    <a asp-action="Index" class="btn btn-primary">All Products</a> 
    <a asp-action="ProductsByPrice" class="btn btn-primary">Search Products by Price</a>
    <hr/>
</p>



<table class="table table-bordered">
    <thead>
        <tr>
            <th>Customer Name</th>
            <th>Product Name</th>
            <th>Quantity</th>
            <th>Sale Date</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var sale in Model)
        {
            <tr>
                <td>@sale.CustomerName</td>
                <td>@sale.ProductName</td>
                <td>@sale.Quantity</td>
                <td>@sale.SaleDate.ToString("yyyy-MM-dd")</td>
            </tr>
        }
    </tbody>
</table>