@model IEnumerable<WebApplication3.Models.Product>

<h2>Search Products by Price</h2>

<p>
    <a asp-action="Index" class="btn btn-primary">All Products</a>
    <a asp-action="SalesDetails" class="btn btn-primary">Sales Report</a>
</p>


<form asp-action="ProductsByPrice" method="get">

    <label for="minimumPrice">Minimum Price</label>

    <input name="minimumPrice"  class="form-control" />

    <label for="maximumPrice">Maximum Price</label>

    <input name="maximumPrice"  class="form-control" />

    <button type="submit" class="btn btn-primary mt-2"> Search </button>

</form>

<hr />




<table class="table table-bordered">
    <thead>
        <tr>
            <th>Product ID</th>
            <th>Product Name</th>
            <th>Price</th>
            <th>Stock Quantity</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductId</td>
                <td>@product.ProductName</td>
                <td>@product.Price</td>
                <td>@product.StockQuantity</td>
            </tr>
        }
    </tbody>
</table>